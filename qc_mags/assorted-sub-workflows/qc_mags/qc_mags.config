params {
    checkm2_db = "/data/pam/software/checkm2_db/uniref100.KO.1.dmnd"
    gunc_db = "/data/pam/software/gunc/GTDB/gunc_db_gtdb95.dmnd"
    mdmcleaner_db = "/data/pam/software/mdmcleaner/v1"
    gtdbtk_db = "/data/pam/software/GTDBTk/release232"
    // Taxonomy assignment mode (GTDB-Tk).
    //   true (DEFAULT in the team162 branch) - "fast": genomes matched to a GTDB species representative by
    //                     the skani ANI screen are assigned from that match; only
    //                     unmatched genomes are placed in the tree. Genomes with no
    //                     match are STILL placed - fast_taxonomy only skips placement
    //                     that skani has already made redundant.
    //                     Suitable for well-characterised communities (human gut,
    //                     clinical isolates). Lowers the per-sample ask from
    //                     8 cores / 64 GB to 2 cores / 32 GB.
    //   false           - upstream behaviour: every genome is also placed in the
    //                     pplacer reference tree (passes --place_species). Use this
    //                     for under-characterised environments (soil, marine,
    //                     non-human hosts) where many genomes lack a close GTDB relative.
    //
    // NOTE: team162 default differs from upstream (which is false). This branch targets
    // human gut / clinical cohorts, where ~99% of genomes match a GTDB representative.
    fast_taxonomy = true
    fasta_ext = "fa"
    min_contig = 1000
    report_config = "${projectDir}/assorted-sub-workflows/qc_mags/assets/report_config.json"
    autoqc_config = null
    skip_raw_reports = false
    temp_file_storage = "/tmp"
    temp_space = "30GB"
    batch_size = 0
    // genome_status column in the report: "auto" = legacy name heuristic
    // ("mag" if the genome name contains "MAG", else "isolate"); "mag" or
    // "isolate" sets that value for every genome.
    genome_type = "auto"
    // LSF fairshare group (e.g. "team162f"). When set, every task is submitted
    // with -G <group>. Without it, tasks use your default group - and the
    // GTDBTK/MDMCLEANER withName clusterOptions below used to REPLACE any -G
    // passed through a generic clusterOptions, so it had to be repeated there.
    lsf_group = null
}
    
// Size-dependent cpus/memory live here as closures, not as `label cond ? a : b`
// ternaries in the modules. A label is resolved when the process is DEFINED, so
// a ternary label could not be changed from a -c config, and an unknown label
// (e.g. the old "mem_50") silently fell back to the 1 GB default. A closure here
// is evaluated per task, so -c / --batch_size / --fast_taxonomy all take effect.
// The values reproduce the previous labels exactly, including nextflow-commons'
// escalation (mem_N: N * 2^(attempt-1); mem_120: 120, then 120 * 1.25 * attempt;
// time_12: 12 h, then 12 h * 2 * attempt). Note check_max() from the commons
// config is not visible in an included config, so these are not capped by
// params.max_cpus / max_memory (irrelevant on the farm, max 256 cpus / 2.9 TB).

process {
    // -G <group> for every task when --lsf_group is set (withName blocks that
    // set their own clusterOptions add it themselves - GTDBTK, MDMCLEANER).
    clusterOptions = { params.lsf_group ? "-G ${params.lsf_group}" : "" }

    // Small-run memory branch raised mem_8 -> mem_16. Measured on a 468-sample
    // run: PRE_CHECKM2 peaked at 8,256 MB and 422/468 tasks died with
    // TERM_MEMLIMIT at 8 GB. The overshoot is small but the failure is total,
    // and because REPORT joins on this output a failed task removes the whole
    // sample from the final report.
    withName:'CHECKM2|PRE_CHECKM2' {
        cpus   = { params.batch_size > 100 ? 32 : 4 }
        memory = { 16.GB * (1 << (task.attempt - 1)) }
        // The module's label "time_queue_from_short" does not exist in
        // nextflow-commons, so CheckM2 silently got the 1 h default. Measured on
        // 468-genome batches: median 62 min, max 123 min - about half would have
        // been killed on attempt 1. 4 h x attempt keeps every attempt on `normal`.
        time   = { 4.h * task.attempt }
    }

    withName:GTDBTK {
        // Fast-taxonomy memory history:
        //  * "mem_50" DOES NOT EXIST in nextflow-commons - only "mem_50M" (50 MB)
        //    does, so large fast runs were silently given the 1 GB default.
        //  * mem_32 was too small: measured 40,675 MB peak on a 468-sample run,
        //    96/110 tasks killed by TERM_MEMLIMIT. Raised to 64 GB.
        // (Nextflow's trace peak_rss reports 126-166 GB for these tasks; that is
        //  pplacer's shared pages summed across its process tree. LSF's own
        //  Max Memory, ~40 GB, is the real figure.)
        cpus   = { params.fast_taxonomy ? (params.batch_size > 100 ? 4 : 2)
                                        : (params.batch_size > 100 ? 64 : 8) }
        memory = { (params.fast_taxonomy || params.temp_file_storage)
                       ? 64.GB * (1 << (task.attempt - 1))
                       : (task.attempt == 1 ? 120.GB : 120.GB * 1.25 * task.attempt) }
        // Fast batches take 20-60 min. The old time_12 label (12 h, then 48 h)
        // routed every retry - and any task over 12 h - onto the congested
        // `long` queue. 4 h keeps attempts 1-3 on `normal`. Non-fast mode keeps
        // the previous time_12 behaviour.
        time   = { params.fast_taxonomy ? 4.h * task.attempt
                                        : (task.attempt == 1 ? 12.h : 12.h * 2 * task.attempt) }
        maxForks = 10
        clusterOptions = { (params.lsf_group ? "-G ${params.lsf_group} " : "") + "-R 'select[tmp>${params.temp_space}]'" }
        // Retry on ANY exit, not just nextflow-commons' SCALING_EXIT_CODES.
        // A GTDB-Tk task died with `BrokenPipeError: [Errno 32]` raised inside
        // tqdm's progress-bar write - a transient stderr-pipe failure, with 40 GB
        // of 64 GB used. It exits 1, which the default retry_strategy maps to
        // 'ignore'. GTDB-Tk classifies genomes in batches, so that one silent
        // drop would remove taxonomy for every genome in the batch.
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }

    // MDMCLEANER shells out to `diamond blastp --threads 16` against
    // gtdbplus_protdb.dmnd (137M sequences / 51.8 G letters). Diamond spills
    // large temp files (diamond-tmp-*) next to its output. Without a tmp
    // reservation the task can land on a node with no room and diamond aborts
    // with SIGABRT and "Error writing file ... diamond-tmp-XXXXXX"; mdmcleaner
    // then raises RuntimeError and the bin is silently skipped under
    // errorStrategy. Observed on 20 bins across 4 samples at 6,989-bin scale
    // (0.29%), at 4.1 GB of 8 GB memory - so it is disk, not RAM.
    withName:MDMCLEANER {
        clusterOptions = { (params.lsf_group ? "-G ${params.lsf_group} " : "") + "-R 'select[tmp>${params.temp_space}]'" }
        // One genome per task, ~10 min each. The time_12 label escalated
        // retries to 48 h / 72 h, i.e. onto the long/week queues.
        time           = { 2.h * task.attempt }
        errorStrategy  = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries     = 2
    }

    // GUNC and MDMCLEANER both shell out to DIAMOND, which writes large
    // diamond-tmp-* files beside its output. Three post-QC GUNC tasks on a
    // 468-sample run died with "Error writing file .../work/.../diamond-tmp-XXX"
    // at 10-12 GB of 32 GB memory, with no Lustre OST above 52% - and all three
    // failed within ~90 s of each other at the same wall-clock moment, from
    // tasks submitted 17 s apart. That is one transient filesystem event, not a
    // resource shortfall. DIAMOND exits 1, which nextflow-commons' retry_strategy
    // maps to 'ignore', so without this the samples would be dropped silently.
    // A retry on a later attempt succeeds.
    withName:'GUNC|PRE_GUNC' {
        // Small-run memory branch raised mem_8 -> mem_16: PRE_GUNC peaked at
        // 9,711 MB and 464/468 tasks died with TERM_MEMLIMIT at 8 GB on a
        // 468-sample run; each failure silently drops a sample from the report.
        cpus   = { params.batch_size > 100 ? 32 : 16 }
        memory = { (params.batch_size > 100 ? 32.GB : 16.GB) * (1 << (task.attempt - 1)) }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
}
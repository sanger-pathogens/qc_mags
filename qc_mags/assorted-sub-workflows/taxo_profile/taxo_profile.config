includeConfig "../kraken2bracken/kraken2bracken.config"

params {
    // Sylph parameters
    sylph_profile = true
    sylph_db = "/data/pam/software/sylph/gtdb-r226-c200-dbv1/gtdb-r226-c200-dbv1.syldb"
    save_sylph_sketches = false
    sylph_k = 31 // Only ksize 21 or 31 supported
    sylph_tax_metadata = "/data/pam/software/sylph-tax/v1/gtdb_r226_metadata.tsv"
    sylph_estimate_unknown = true
    sylph_read_seq_id = 99.5 //estimated percentage identity of your sequences (i.e. 100 - error percent). 99.5 is recommeded for Illumina reads.
    genome_path_prefix = ""
    // Kraken2 parameters
    bracken_profile = false
    kraken2_db = "/data/pam/software/kraken2/standard/k2_standard_20250402"
    bracken_classification_level = 'S' // Cannot check the accuracy of classification at species level if bracken classification level is not set to 'S' (species)
    read_len = 150
}

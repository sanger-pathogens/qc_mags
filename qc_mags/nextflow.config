// Copyright (C) 2024 Genome Research Ltd.

// Config inheritance options
params {
    generic_config_base = "https://raw.githubusercontent.com/sanger-pathogens/nextflow-commons/"
    generic_config_version = "master"
    generic_config_url = ""
}
inherit_generic_config()

manifest {
    name            = 'qc_mags'
    author          = 'PAM Informatics'
    homePage        = 'https://gitlab.internal.sanger.ac.uk/sanger-pathogens/pipelines/qc_mags'
    description     = 'QC pipeline for Metagenome Assembled Genomes (MAGs)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version         = 'v1.0.1'
    recurseSubmodules = true
}

includeConfig "${projectDir}/assorted-sub-workflows/qc_mags/qc_mags.config"

params {
    // Logging options
    monochrome_logs = false

    recursive = false

    // Output options
    outdir = "./results"
}

process {
    maxRetries = params.max_retries
}

// LSF submission queue size. nextflow-commons' `standard` profile sets
// executor.queueSize = params.queue_size (default null -> Nextflow's 100
// queued+running jobs), and profile settings are merged AFTER the top-level
// config, so a plain executor.queueSize here is overwritten. Re-declare it in
// the same profile instead (later definitions of a profile win).
// MDMCLEANER runs one task per genome, so 100 slots throttled a 78k-genome run
// to ~90 genomes/h. Override with --queue_size N.
profiles {
    standard {
        executor {
            queueSize = params.queue_size ?: 300
        }
    }
}

// Helper functions
def inherit_generic_config() {
    config_url = params.generic_config_url ? params.generic_config_url : "${params.generic_config_base}/${params.generic_config_version}/configs/nextflow.config"
    try {
        includeConfig "${config_url}"
    } catch (Exception e) {
        System.err.println("ERROR: Could not load generic config: ${config_url}")
        System.err.println("Encountered the following exception:")
        throw e
    }
}
// Completion audit: compare genomes found in the manifest's mags_dirs against
// rows in the batch reports, and flag rows with no taxonomy / no post-QC CheckM2.
// Tasks dropped by errorStrategy 'ignore' (or a REPORT that refused to write a
// taxonomy-less batch) otherwise vanish silently: on a 468-sample run 72/83
// batch reports had no taxonomy and nothing in the log said so.
// Config scope: `log` is null (use println) and file() is unavailable (use
// java.io.File). This runs in addition to main.nf's onComplete summary.
workflow.onComplete = {
    try {
        String ext = params.fasta_ext.toString().replaceAll(/^\./, '')
        def genomes = [] as LinkedHashSet
        def mf = params.manifest ? new File(params.manifest.toString()) : null
        if (mf?.exists()) {
            def lines = mf.readLines().findAll { it.trim() }
            def header = lines[0].split(',', -1).collect { it.trim() }
            int dirIdx = header.indexOf('mags_dir')
            lines.drop(1).each { line ->
                def cols = line.split(',', -1)
                if (dirIdx < 0 || dirIdx >= cols.size()) return
                def dir = new File(cols[dirIdx].trim())
                if (!dir.isDirectory()) return
                def match = { File f -> f.isFile() && f.name.endsWith(".${ext}") }
                if (params.recursive) {
                    dir.eachFileRecurse(groovy.io.FileType.FILES) { f -> if (match(f)) genomes << f.canonicalPath }
                } else {
                    dir.listFiles().findAll(match).each { genomes << it.canonicalPath }
                }
            }
        }
        int reported = 0, withTax = 0, withCheckm2 = 0
        def reportDir = new File("${params.outdir}/report")
        def reports = reportDir.isDirectory() ?
            reportDir.listFiles().findAll { it.name.endsWith('_final_report.tsv') && it.name != 'all_final_report.tsv' } : []
        reports.each { rf ->
            def lines = rf.readLines()
            if (!lines) return
            def header = lines[0].split('\t', -1) as List
            int taxIdx = header.indexOf('gtdbtk_classification')
            int cmIdx = header.indexOf('checkm2_postqc_Completeness')
            lines.drop(1).findAll { it.trim() }.each { row ->
                def cols = row.split('\t', -1)
                reported++
                if (taxIdx >= 0 && taxIdx < cols.size() && cols[taxIdx].trim()) withTax++
                if (cmIdx >= 0 && cmIdx < cols.size() && cols[cmIdx].trim()) withCheckm2++
            }
        }
        println "[completion audit] genomes=${genomes.size()} reported=${reported} with_taxonomy=${withTax} with_postqc_checkm2=${withCheckm2} (batch reports: ${reports.size()})"
        if (genomes.size() > reported)
            println "[completion audit] WARNING: ${genomes.size() - reported} GENOME(S) MISSING FROM THE REPORTS - a task was dropped by errorStrategy 'ignore'; check the trace / .nextflow.log before the work dir is cleaned"
        if (reported > withTax)
            println "[completion audit] WARNING: ${reported - withTax} reported genome(s) have EMPTY gtdbtk_classification"
        if (reported > withCheckm2)
            println "[completion audit] WARNING: ${reported - withCheckm2} reported genome(s) have EMPTY post-QC CheckM2 completeness"
    } catch (Exception e) {
        println "[completion audit] WARNING: could not run: ${e.message}"
    }
}

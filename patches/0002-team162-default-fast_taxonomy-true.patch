From 4cf3c3fdefa458662bb085ab29a003ec248a02c9 Mon Sep 17 00:00:00 2001
From: Yan Shao <ys4@sanger.ac.uk>
Date: Fri, 4 Sep 2026 12:26:00 +0100
Subject: [PATCH 2/3] team162: default fast_taxonomy=true

This branch targets human gut / clinical cohorts where ~99.4% of genomes match a
GTDB species representative (measured: 4165/4190 across the Sanger and NCL sets).
Upstream default remains false; cut an MR from the previous commit to propose the
opt-in form without this default change.
---
 .../assorted-sub-workflows/qc_mags/qc_mags.config   | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/qc_mags/assorted-sub-workflows/qc_mags/qc_mags.config b/qc_mags/assorted-sub-workflows/qc_mags/qc_mags.config
index c326f28..65be37e 100644
--- a/qc_mags/assorted-sub-workflows/qc_mags/qc_mags.config
+++ b/qc_mags/assorted-sub-workflows/qc_mags/qc_mags.config
@@ -4,9 +4,7 @@ params {
     mdmcleaner_db = "/data/pam/software/mdmcleaner/v1"
     gtdbtk_db = "/data/pam/software/GTDBTk/release232"
     // Taxonomy assignment mode (GTDB-Tk).
-    //   false (DEFAULT) - unchanged behaviour: every genome is also placed in the
-    //                     pplacer reference tree (passes --place_species).
-    //   true            - "fast": genomes matched to a GTDB species representative by
+    //   true (DEFAULT in the team162 branch) - "fast": genomes matched to a GTDB species representative by
     //                     the skani ANI screen are assigned from that match; only
     //                     unmatched genomes are placed in the tree. Genomes with no
     //                     match are STILL placed - fast_taxonomy only skips placement
@@ -14,7 +12,14 @@ params {
     //                     Suitable for well-characterised communities (human gut,
     //                     clinical isolates). Lowers the per-sample ask from
     //                     8 cores / 64 GB to 2 cores / 32 GB.
-    fast_taxonomy = false
+    //   false           - upstream behaviour: every genome is also placed in the
+    //                     pplacer reference tree (passes --place_species). Use this
+    //                     for under-characterised environments (soil, marine,
+    //                     non-human hosts) where many genomes lack a close GTDB relative.
+    //
+    // NOTE: team162 default differs from upstream (which is false). This branch targets
+    // human gut / clinical cohorts, where ~99% of genomes match a GTDB representative.
+    fast_taxonomy = true
     fasta_ext = "fa"
     min_contig = 1000
     report_config = "${projectDir}/assorted-sub-workflows/qc_mags/assets/report_config.json"
-- 

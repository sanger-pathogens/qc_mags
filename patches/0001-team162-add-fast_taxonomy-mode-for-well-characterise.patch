From fc91621d02a875c77bfa783f3f702a2971f86161 Mon Sep 17 00:00:00 2001
From: Yan Shao <ys4@sanger.ac.uk>
Date: Fri, 4 Sep 2026 12:25:05 +0100
Subject: [PATCH 1/3] team162: add fast_taxonomy mode for well-characterised
 communities

GTDB-Tk >=2.7 runs a skani ANI screen against all GTDB references before any
tree placement. qc_mags passes --place_species unconditionally, which forces
pplacer for every genome even when skani has already assigned a species.

Adds params.fast_taxonomy (default false = unchanged behaviour). When true:
  - omits --place_species, so only genomes with no ANI match are placed
  - lowers the unbatched ask from cpu_8/mem_64 to cpu_2/mem_32

Measured on 4190 human gut MAGs (Sanger + NCL cohorts, GTDB r232):
  - 4165/4190 (99.4%) assigned by the ANI screen; 25 required placement
  - taxonomy identical to --place_species on all genomes compared (13/13, 2/2)
  - GTDBTK per-sample task: measured 1.0-1.8 cores, ~15 GB peak (vs 8 cores/64 GB reserved)
  - genomes with no ANI match are STILL placed - verified on 2 novel genomes

Rationale is schedulability rather than runtime: during farm contention the
8-core/64 GB task sat unschedulable for 30h while 1-core jobs ran.
---
 .../assorted-sub-workflows/qc_mags/modules/gtdbtk.nf |  7 ++++---
 .../assorted-sub-workflows/qc_mags/qc_mags.config    | 12 ++++++++++++
 2 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/qc_mags/assorted-sub-workflows/qc_mags/modules/gtdbtk.nf b/qc_mags/assorted-sub-workflows/qc_mags/modules/gtdbtk.nf
index 7492a2e..3402c8a 100644
--- a/qc_mags/assorted-sub-workflows/qc_mags/modules/gtdbtk.nf
+++ b/qc_mags/assorted-sub-workflows/qc_mags/modules/gtdbtk.nf
@@ -1,8 +1,8 @@
 process GTDBTK {
     tag "${meta.ID}"
-    label params.batch_size > 100 ? "cpu_64" : "cpu_8"
+    label params.batch_size > 100 ? "cpu_64" : (params.fast_taxonomy ? "cpu_2" : "cpu_8")
     label "time_12"
-    label params.temp_file_storage ? "mem_64" : "mem_120"
+    label params.batch_size > 100 ? "mem_50" : (params.fast_taxonomy ? "mem_32" : (params.temp_file_storage ? "mem_64" : "mem_120"))
 
 
     container  'quay.io/biocontainers/gtdbtk:2.7.2--pyhdfd78af_0'
@@ -18,6 +18,7 @@ process GTDBTK {
 
     script:
     report_tsv = "${meta.ID}_gtdbtk_summary.tsv"
+    place_flag = params.fast_taxonomy ? "" : "--place_species"
 
     """
     if [[ -n ${params.temp_file_storage} && "${params.temp_file_storage}" != "null" ]]; then
@@ -38,7 +39,7 @@ process GTDBTK {
 
     export GTDBTK_DATA_PATH="${params.gtdbtk_db}"
 
-    gtdbtk classify_wf --genome_dir fastas -x ${params.fasta_ext} --place_species --cpus ${task.cpus} --out_dir gtdbtk_outdir \$scratch_flag
+    gtdbtk classify_wf --genome_dir fastas -x ${params.fasta_ext} ${place_flag} --cpus ${task.cpus} --out_dir gtdbtk_outdir \$scratch_flag
 
     cp gtdbtk_outdir/gtdbtk.bac*.summary.tsv ${report_tsv}
 
diff --git a/qc_mags/assorted-sub-workflows/qc_mags/qc_mags.config b/qc_mags/assorted-sub-workflows/qc_mags/qc_mags.config
index 73674f6..c326f28 100644
--- a/qc_mags/assorted-sub-workflows/qc_mags/qc_mags.config
+++ b/qc_mags/assorted-sub-workflows/qc_mags/qc_mags.config
@@ -3,6 +3,18 @@ params {
     gunc_db = "/data/pam/software/gunc/GTDB/gunc_db_gtdb95.dmnd"
     mdmcleaner_db = "/data/pam/software/mdmcleaner/v1"
     gtdbtk_db = "/data/pam/software/GTDBTk/release232"
+    // Taxonomy assignment mode (GTDB-Tk).
+    //   false (DEFAULT) - unchanged behaviour: every genome is also placed in the
+    //                     pplacer reference tree (passes --place_species).
+    //   true            - "fast": genomes matched to a GTDB species representative by
+    //                     the skani ANI screen are assigned from that match; only
+    //                     unmatched genomes are placed in the tree. Genomes with no
+    //                     match are STILL placed - fast_taxonomy only skips placement
+    //                     that skani has already made redundant.
+    //                     Suitable for well-characterised communities (human gut,
+    //                     clinical isolates). Lowers the per-sample ask from
+    //                     8 cores / 64 GB to 2 cores / 32 GB.
+    fast_taxonomy = false
     fasta_ext = "fa"
     min_contig = 1000
     report_config = "${projectDir}/assorted-sub-workflows/qc_mags/assets/report_config.json"
-- 
